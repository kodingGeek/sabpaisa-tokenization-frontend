# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
REACT_APP_WEBSOCKET_URL=ws://localhost:8080/ws

# Security Configuration
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
REACT_APP_SESSION_TIMEOUT=900000
REACT_APP_INACTIVITY_TIMEOUT=900000
REACT_APP_MFA_TIMEOUT=300000

# Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_MFA=true
REACT_APP_ENABLE_BIOMETRIC=false
REACT_APP_ENABLE_AUDIT_DOWNLOAD=true

# Monitoring
REACT_APP_SENTRY_DSN=
REACT_APP_ANALYTICS_ID=

# AWS Configuration (for client-side SDK if needed)
REACT_APP_AWS_REGION=ap-south-1
REACT_APP_AWS_COGNITO_POOL_ID=
REACT_APP_AWS_COGNITO_CLIENT_ID=