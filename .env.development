# Development Environment Configuration
# This configuration is for AWS development environment

# API Configuration - Will be replaced by deployment pipeline
REACT_APP_API_BASE_URL=http://sabpaisa-token-api-dev-alb.ap-south-1.elb.amazonaws.com/api/api/v1
REACT_APP_API_TIMEOUT=30000
REACT_APP_WEBSOCKET_URL=ws://sabpaisa-token-api-dev-alb.ap-south-1.elb.amazonaws.com/ws

# Environment Settings
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=$npm_package_version
REACT_APP_BUILD_TIME=$BUILD_TIME
REACT_APP_API_VERSION=v1

# Security Configuration
REACT_APP_RECAPTCHA_SITE_KEY=${RECAPTCHA_SITE_KEY_DEV}
REACT_APP_RECAPTCHA_ENABLED=true
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_INACTIVITY_TIMEOUT=900000
REACT_APP_MFA_TIMEOUT=300000
REACT_APP_REMEMBER_ME_DURATION=86400000

# Feature Flags - Most enabled for development
REACT_APP_ENABLE_MFA=true
REACT_APP_ENABLE_BIOMETRIC=true
REACT_APP_ENABLE_AUDIT_DOWNLOAD=true
REACT_APP_ENABLE_BULK_OPERATIONS=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ENTERPRISE_FEATURES=true
REACT_APP_ENABLE_FRAUD_DETECTION=true
REACT_APP_ENABLE_QUANTUM_ENCRYPTION=false
REACT_APP_ENABLE_MULTI_CLOUD=true

# Development Tools
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_API_MOCKING=false
REACT_APP_SHOW_ENV_BANNER=true
REACT_APP_ENABLE_HOT_RELOAD=false

# Build Configuration
SKIP_PREFLIGHT_CHECK=true
TSC_COMPILE_ON_ERROR=true
GENERATE_SOURCEMAP=true
REACT_APP_BUNDLE_VISUALIZE=false

# Monitoring and Analytics
REACT_APP_SENTRY_DSN=${SENTRY_DSN_DEV}
REACT_APP_SENTRY_ENABLED=true
REACT_APP_SENTRY_ENVIRONMENT=development
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_ANALYTICS_ID=${ANALYTICS_ID_DEV}
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_LOG_LEVEL=debug

# AWS Configuration
REACT_APP_AWS_REGION=ap-south-1
REACT_APP_AWS_COGNITO_POOL_ID=${COGNITO_POOL_ID_DEV}
REACT_APP_AWS_COGNITO_CLIENT_ID=${COGNITO_CLIENT_ID_DEV}
REACT_APP_S3_BUCKET=sabpaisa-tokenization-dev

# Payment Gateway Configuration
REACT_APP_PAYMENT_GATEWAY_MODE=test
REACT_APP_RAZORPAY_KEY=${RAZORPAY_KEY_DEV_TEST}
REACT_APP_STRIPE_KEY=${STRIPE_KEY_DEV_TEST}

# Theme Configuration
REACT_APP_THEME_MODE=light
REACT_APP_PRIMARY_COLOR=#1976d2
REACT_APP_SECONDARY_COLOR=#dc004e

# Limits and Constraints
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_MAX_BULK_TOKENS=500
REACT_APP_PAGINATION_SIZE=25
REACT_APP_MAX_EXPORT_RECORDS=5000

# Cache Configuration
REACT_APP_CACHE_DURATION=600000
REACT_APP_CACHE_ENABLED=true

# URLs for different services
REACT_APP_DOCS_URL=https://dev-docs.sabpaisa.com
REACT_APP_SUPPORT_URL=https://dev-support.sabpaisa.com
REACT_APP_TERMS_URL=https://dev.sabpaisa.com/terms
REACT_APP_PRIVACY_URL=https://dev.sabpaisa.com/privacy

# CORS Configuration
REACT_APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://dev.sabpaisa.com

# Error Tracking
REACT_APP_ERROR_BOUNDARY_ENABLED=true
REACT_APP_ERROR_BOUNDARY_FALLBACK=true

# Performance Monitoring
REACT_APP_PERFORMANCE_MONITORING_ENABLED=true
REACT_APP_PERFORMANCE_SAMPLE_RATE=0.1